+name: BabyLoveGrowth article sync
+
+on:
+  schedule:
+    # Daily at 14:00 UTC — keeps articles fresh without hitting rate limits
+    - cron: "0 14 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+concurrency:
+  group: babylovegrowth-sync
+  cancel-in-progress: false
+
+jobs:
+  sync:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup Node
+        uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+
+      - name: Sync articles
+        env:
+          BABYLOVEGROWTH_API_KEY: ${{ secrets.BABYLOVEGROWTH_API_KEY }}
+        run: node scripts/sync-babylovegrowth.mjs
+
+      - name: Commit updated content
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add src/content/babylovegrowth/articles.json src/content/babylovegrowth/sync-state.json
+          if git diff --staged --quiet; then
+            echo "No article changes"
+          else
+            git commit -m "chore(blog): sync BabyLoveGrowth articles"
+            git push
+          fi
